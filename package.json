{
  "name": "sonicbridge",
  "version": "1.0.0",
  "description": "SW-41 acoustic data link",
  "scripts": {
    "predev": "node scripts/prepare-runtime.mjs && node scripts/make-icons.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-runtime.mjs && node scripts/make-icons.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "serve:https": "node scripts/serve-https.mjs",
    "download:speech-model": "node scripts/download-offline-speech.mjs",
    "benchmark": "vitest run --config evaluation/vitest.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@huggingface/transformers": "^4.3.2",
    "@noble/hashes": "2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ggwave": "0.4.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true
}
